---
- name: "Oracle - Check Restore Points CDB y PDBs"
  hosts: "{{ target_host | default('oracle_servers') }}"
  gather_facts: true
  serial: 5
  vars:
    oracle_os_user: "oracle"
    oracle_user:    "/ as sysdba"
    env_file:       "/home/oracle/{{ cdb }}.env"
    local_out_dir:  "/ansible_restore_point"
    log_file:       "{{ local_out_dir }}/{{ inventory_hostname }}_{{ cdb }}_{{ ansible_date_time.date }}.log"
    resumen_file:   "{{ local_out_dir }}/RESUMEN_CON_RP_{{ ansible_date_time.date }}.txt"

  pre_tasks:

    - name: "PRE | Crear directorio de salida en controller"
      ansible.builtin.file:
        path: "{{ local_out_dir }}"
        state: directory
        mode: '0755'
      delegate_to: localhost
      run_once: true

    - name: "PRE | Inicializar fichero resumen"
      ansible.builtin.copy:
        dest: "{{ resumen_file }}"
        content: |
          ================================================================================
           BASES DE DATOS CON RESTORE POINTS ACTIVOS - {{ ansible_date_time.date }}
          ================================================================================
        force: false
        mode: '0644'
      delegate_to: localhost
      run_once: true

  tasks:

    - name: "1 | Consultar restore points en CDB y todas sus PDBs"
      ansible.builtin.shell: |
        source {{ env_file }}
        sqlplus -s "{{ oracle_user }}" << 'EOF'
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF LINESIZE 300
        SET SERVEROUTPUT ON SIZE UNLIMITED
        ALTER SESSION SET NLS_DATE_FORMAT='DD/MM/YYYY HH24:MI:SS';

        -- CDB$ROOT
        SELECT
            'CDB$ROOT'                                  || '|' ||
            rp.name                                     || '|' ||
            rp.guarantee_flashback_database             || '|' ||
            TO_CHAR(rp.time,'DD/MM/YYYY HH24:MI:SS')   || '|' ||
            ROUND((SYSDATE - rp.time), 2)              || '|' ||
            NVL(rp.storage_size, 0)                    || '|' ||
            rp.scn
        FROM v\$restore_point rp;

        -- PDBs
        DECLARE
            CURSOR c_pdbs IS
                SELECT name FROM v\$pdbs
                WHERE name NOT IN ('PDB\$SEED')
                AND open_mode = 'READ WRITE';
        BEGIN
            FOR r_pdb IN c_pdbs LOOP
                EXECUTE IMMEDIATE 'ALTER SESSION SET CONTAINER=' || r_pdb.name;
                FOR r_rp IN (
                    SELECT name, guarantee_flashback_database,
                           time, storage_size, scn
                    FROM v\$restore_point
                ) LOOP
                    DBMS_OUTPUT.PUT_LINE(
                        r_pdb.name                                  || '|' ||
                        r_rp.name                                   || '|' ||
                        r_rp.guarantee_flashback_database           || '|' ||
                        TO_CHAR(r_rp.time,'DD/MM/YYYY HH24:MI:SS') || '|' ||
                        ROUND((SYSDATE - r_rp.time), 2)            || '|' ||
                        NVL(r_rp.storage_size, 0)                  || '|' ||
                        r_rp.scn
                    );
                END LOOP;
                EXECUTE IMMEDIATE 'ALTER SESSION SET CONTAINER=CDB\$ROOT';
            END LOOP;
        END;
        /
        EXIT;
        EOF
      register: r_restore_points
      changed_when: false
      become: true
      become_user: "{{ oracle_os_user }}"
      args:
        executable: /bin/bash

    - name: "2 | Parsear lineas validas"
      ansible.builtin.set_fact:
        rp_list: "{{ r_restore_points.stdout_lines | select('match', '.+\\|.+\\|.+') | list }}"

    - name: "3 | Guardar log individual por CDB"
      ansible.builtin.copy:
        dest: "{{ log_file }}"
        mode: '0644'
        content: |
          ================================================================================
           Host : {{ inventory_hostname }}  |  CDB : {{ cdb }}
           Fecha: {{ ansible_date_time.iso8601 }}
          ================================================================================
          {% if rp_list | length == 0 %}
          Sin restore points activos.
          {% else %}
          Total restore points encontrados: {{ rp_list | length }}
          ──────────────────────────────────────────────────────────────────────────────
          {% for line in rp_list %}
          {% set c = line.split('|') %}
            · Contenedor : {{ c[0] }}
              Nombre     : {{ c[1] }}
              Guaranteed : {{ c[2] }}
              Creado     : {{ c[3] }}
              Antigüedad : {{ c[4] | float | round(1) }} días
              Storage    : {{ (c[5] | int / 1073741824) | round(2) }} GB
              SCN        : {{ c[6] }}
          {% endfor %}
          {% endif %}
          ================================================================================
      delegate_to: localhost

    - name: "4 | Añadir al resumen solo las CDBs con restore points"
      ansible.builtin.blockinfile:
        path: "{{ resumen_file }}"
        marker: "# {mark} {{ inventory_hostname }}_{{ cdb }}"
        block: |

          ┌──────────────────────────────────────────────────────────────────────────────
          │ Host : {{ inventory_hostname }}  |  CDB : {{ cdb }}
          ├──────────────────────────────────────────────────────────────────────────────
          {% for line in rp_list %}
          {% set c = line.split('|') %}
          │  · Contenedor : {{ c[0] }}
          │    Nombre     : {{ c[1] }}
          │    Guaranteed : {{ c[2] }}
          │    Creado     : {{ c[3] }}
          │    Antigüedad : {{ c[4] | float | round(1) }} días
          │    Storage    : {{ (c[5] | int / 1073741824) | round(2) }} GB
          │    SCN        : {{ c[6] }}
          │
          {% endfor %}
          └──────────────────────────────────────────────────────────────────────────────
        insertafter: EOF
        mode: '0644'
      delegate_to: localhost
      when: rp_list | length > 0

  post_tasks:

    - name: "POST | Pie del resumen"
      ansible.builtin.lineinfile:
        path: "{{ resumen_file }}"
        line: |

          ================================================================================
           FIN - {{ ansible_date_time.iso8601 }}
          ================================================================================
        insertafter: EOF
      delegate_to: localhost
      run_once: true
```

---

## Resultado en `/ansible_restore_point/`
```
# Log individual por cada CDB (todas, tengan o no restore points)
oradb01_CDB1_2026-02-23.log
oradb02_CDB2_2026-02-23.log
oradb03_CDB3_2026-02-23.log

# Resumen consolidado (solo las que tienen restore points)
RESUMEN_CON_RP_2026-02-23.txt
```

---

## Flujo resumido
```
Por cada host/CDB
    ├── Consulta CDB$ROOT  → v$restore_point
    ├── Consulta cada PDB  → ALTER SESSION SET CONTAINER + v$restore_point
    ├── Guarda log individual (todas)
    └── Si tiene restore points → añade al resumen consolidado
