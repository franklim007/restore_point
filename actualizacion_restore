---
- name: Consultar Restore Points activos en Oracle - Resumen Global
  hosts: oracle_servers
  become: yes
  become_user: oracle
  gather_facts: false
  vars:
    oracle_home: "/u01/app/oracle/product/19c/dbhome_1"
    oracle_sid: "ORCL"

  tasks:
    - name: Escribir cabecera del log
      copy:
        dest: "{{ log_file }}"
        content: |
          ============================================================
          CONSULTA RESTORE POINTS ORACLE
          ============================================================
          Host         : {{ inventory_hostname }}
          IP           : {{ ansible_default_ipv4.address | default('N/A') }}
          SID          : {{ oracle_sid }}
          Fecha/Hora   : {{ ansible_date_time.iso8601 }}
          Usuario      : {{ ansible_user_id }}
          ============================================================

    - name: Contar y obtener restore points activos
      shell: |
        export ORACLE_SID={{ oracle_sid }}
        export ORACLE_HOME={{ oracle_home }}
        export PATH=$ORACLE_HOME/bin:$PATH
        sqlplus -s / as sysdba <<EOF
        SET PAGESIZE 0
        SET FEEDBACK OFF
        SET HEADING OFF
        SET COLSEP '|'
        SELECT
            NAME || '|' ||
            TO_CHAR(TIME, 'DD/MM/YYYY HH24:MI:SS') || '|' ||
            GUARANTEE_FLASHBACK_DATABASE || '|' ||
            STORAGE_SIZE
        FROM V\$RESTORE_POINT
        ORDER BY TIME DESC;
        EXIT;
        EOF
      register: rp_output
      ignore_errors: true

    - name: Guardar resultado por host
      set_fact:
        rp_lines: >-
          {{
            rp_output.stdout_lines
            | select('match', '.+\\|.+\\|.+\\|.+')
            | list
          }}

    - name: Marcar host con o sin restore points
      set_fact:
        host_summary:
          host: "{{ inventory_hostname }}"
          sid: "{{ oracle_sid }}"
          count: "{{ rp_lines | length }}"
          restore_points: "{{ rp_lines }}"
          status: "{{ 'CON RESTORE POINTS ⚠️' if rp_lines | length > 0 else 'OK ✅' }}"
          error: "{{ rp_output.stderr | default('') }}"
   - name: Escribir resultado en log - CON restore points
      blockinfile:
        path: "{{ log_file }}"
        block: |
          RESULTADO: ⚠️  SE ENCONTRARON {{ rp_lines | length }} RESTORE POINT(S) ACTIVOS

          DETALLE:
          {% for rp in rp_lines %}
          {% set campos = rp.split('|') %}
            Nombre     : {{ campos[0] | trim }}
            Fecha/Hora : {{ campos[1] | trim }}
            Garantizado: {{ campos[2] | trim }}
            Tamaño     : {{ campos[3] | trim }} bytes
            --------------------------------------------------
          {% endfor %}

          SALIDA RAW SQLPLUS:
          {{ rp_output.stdout }}
        marker: "# {mark} RESULTADO CONSULTA"
      when: rp_lines | length > 0

    - name: Escribir resultado en log - SIN restore points
      blockinfile:
        path: "{{ log_file }}"
        block: |
          RESULTADO: ✅ No se encontraron Restore Points activos.

          SALIDA RAW SQLPLUS:
          {{ rp_output.stdout | default('(sin salida)') }}
        marker: "# {mark} RESULTADO CONSULTA"
      when: rp_lines | length == 0

    - name: Escribir errores en log si los hay
      blockinfile:
        path: "{{ log_file }}"
        block: |
          ⚠️  ERRORES DETECTADOS:
          {{ rp_output.stderr }}
        marker: "# {mark} ERRORES"
      when: rp_output.stderr is defined and rp_output.stderr != ''

    - name: Escribir pie del log
      lineinfile:
        path: "{{ log_file }}"
        line: |

          ============================================================
          FIN DE CONSULTA - {{ ansible_date_time.iso8601 }}
          ============================================================
        insertafter: EOF

    - name: Mostrar ruta del log generado
      debug:
        msg: "Log generado en {{ inventory_hostname }}:{{ log_file }}"

- name: Generar resumen consolidado
  hosts: localhost
  gather_facts: false

  tasks:
    - name: Consolidar resultados de todos los hosts
      set_fact:
        all_summaries: >-
          {{
            groups['oracle_servers']
            | map('extract', hostvars, 'host_summary')
            | list
          }}

    - name: Filtrar solo los que tienen restore points
      set_fact:
        with_rp: "{{ all_summaries | selectattr('count', '>', '0') | list }}"
        without_rp: "{{ all_summaries | selectattr('count', '==', '0') | list }}"
        with_errors: "{{ all_summaries | selectattr('error', '!=', '') | list }}"

    - name: Mostrar resumen ejecutivo
      debug:
        msg: |
          ╔══════════════════════════════════════════════════════════╗
          ║         RESUMEN GLOBAL DE RESTORE POINTS ORACLE          ║
          ╚══════════════════════════════════════════════════════════╝

          📊 ESTADÍSTICAS:
             Total servidores chequeados : {{ all_summaries | length }}
             Con restore points activos  : {{ with_rp | length }}
             Sin restore points          : {{ without_rp | length }}
             Con errores de conexión     : {{ with_errors | length }}

    - name: Mostrar detalle de servidores CON restore points
      debug:
        msg: |
          ⚠️  {{ item.host }} (SID: {{ item.sid }}) — {{ item.count }} restore point(s):
          {% for rp in item.restore_points %}
            → {{ rp }}
          {% endfor %}
      loop: "{{ with_rp }}"
      when: with_rp | length > 0

    - name: Mostrar servidores SIN restore points
      debug:
        msg: "✅ Sin restore points: {{ without_rp | map(attribute='host') | join(', ') }}"
      when: without_rp | length > 0

    - name: Mostrar servidores con errores
      debug:
        msg: "❌ Error en {{ item.host }}: {{ item.error }}"
      loop: "{{ with_errors }}"
      when: with_errors | length > 0

    - name: Guardar resumen en fichero CSV
      copy:
        dest: "/tmp/restore_points_report_{{ ansible_date_time.date }}.csv"
        content: |
          HOST,SID,RESTORE_POINTS,STATUS,DETALLE
          {% for s in all_summaries %}
          {{ s.host }},{{ s.sid }},{{ s.count }},{{ s.status }},"{{ s.restore_points | join(' / ') }}"
          {% endfor %}
      delegate_to: localhost
```

