---
- name: Monitorizacion Restore Points Oracle
  hosts: all
  gather_facts: yes
  vars:
    reports_dir:   "/tmp/ansible/"
    reports_salida: "/tmp/ansible/salida/"
  vars_files:
    - vars_multi.yml

  pre_tasks:

    - name: "PRE | Definir variables de ficheros"
      ansible.builtin.set_fact:
        log_file: "{{ reports_salida }}restore_points_{{ inventory_hostname }}_{{ ansible_date_time.date }}.log"

    - name: "PRE | Crear directorio reports_dir"
      ansible.builtin.file:
        path: "{{ reports_dir }}"
        state: directory
        mode: '0755'

    - name: "PRE | Crear directorio reports_salida"
      ansible.builtin.file:
        path: "{{ reports_salida }}"
        state: directory
        mode: '0755'

  tasks:

    # =========================================
    # VARIABLES ORACLE
    # =========================================
    - name: "1 | Sacar ORACLE_HOME"
      ansible.builtin.shell: |
        cat /home/oracle/{{ cdb }}.env | grep -w "ORACLE_HOME" | cut -d';' -f1 | cut -d'=' -f2
      register: home_cdb
      changed_when: false
      tags: always

    - name: "1 | Sacar ORACLE_UNQNAME"
      ansible.builtin.shell: |
        cat /home/oracle/{{ cdb }}.env | grep -w "ORACLE_UNQNAME" | cut -d';' -f1 | cut -d'=' -f2
      register: cdb_unqname
      changed_when: false
      tags: always

    # =========================================
    # ARQUITECTURA CDB / NON-CDB
    # =========================================
    - name: "2 | Comprobar si es CDB"
      ansible.builtin.shell: |
        export ORACLE_HOME={{ home_cdb.stdout }}
        export PATH=$ORACLE_HOME/bin:$PATH
        export ORACLE_SID={{ oracle_sid }}
        sqlplus -s / as sysdba << 'EOF'
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF
        SELECT cdb FROM v$database;
        EXIT;
        EOF
      register: is_cdb
      changed_when: false

    - name: "2 | Establecer si es multitenant"
      ansible.builtin.set_fact:
        is_multitenant: "{{ 'YES' in is_cdb.stdout }}"

    - name: "2 | Mostrar arquitectura"
      ansible.builtin.debug:
        msg: |
          Servidor    : {{ inventory_hostname }}
          Arquitectura: {{ 'Multitenant (CDB/PDB)' if is_multitenant else 'Non-CDB (Single Instance)' }}

    # =========================================
    # OBTENER PDBs
    # =========================================
    - name: "3 | Obtener lista de PDBs"
      ansible.builtin.shell: |
        export ORACLE_HOME={{ home_cdb.stdout }}
        export PATH=$ORACLE_HOME/bin:$PATH
        export ORACLE_SID={{ oracle_sid }}
        sqlplus -s / as sysdba << 'EOF'
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF
        SELECT name || '|' || con_id || '|' || open_mode FROM v$pdbs ORDER BY con_id;
        EXIT;
        EOF
      register: pdbs_list
      changed_when: false
      when: is_multitenant

    - name: "3 | Inicializar lista PDBs"
      ansible.builtin.set_fact:
        pdbs: []
      when: is_multitenant

    - name: "3 | Parsear PDBs"
      ansible.builtin.set_fact:
        pdbs: "{{ pdbs + [ {
                    'name':      item.split('|')[0],
                    'con_id':    item.split('|')[1],
                    'open_mode': item.split('|')[2]
                  } ] }}"
      with_items: "{{ pdbs_list.stdout_lines }}"
      when:
        - is_multitenant
        - pdbs_list is defined
        - item | length > 0

    - name: "3 | Mostrar PDBs encontradas"
      ansible.builtin.debug:
        msg: |
          PDBs encontradas en {{ inventory_hostname }}:
          {% for pdb in pdbs | default([]) %}
          - {{ pdb.name }} (CON_ID: {{ pdb.con_id }}) - Estado: {{ pdb.open_mode }}
          {% endfor %}
      when: is_multitenant

    # =========================================
    # CABECERA LOG
    # =========================================
    - name: "4 | Escribir cabecera del log"
      ansible.builtin.copy:
        dest: "{{ log_file }}"
        mode: '0644'
        content: |
          ============================================================
          CONSULTA RESTORE POINTS ORACLE
          ============================================================
          Host         : {{ inventory_hostname }}
          IP           : {{ ansible_default_ipv4.address | default('N/A') }}
          SID          : {{ oracle_sid }}
          CDB          : {{ cdb }}
          Arquitectura : {{ 'Multitenant (CDB/PDB)' if is_multitenant else 'Non-CDB' }}
          Fecha/Hora   : {{ ansible_date_time.iso8601 }}
          ============================================================

    # =========================================
    # CONSULTA RESTORE POINTS
    # =========================================
    - name: "5 | Consultar restore points"
      ansible.builtin.shell: |
        export ORACLE_HOME={{ home_cdb.stdout }}
        export PATH=$ORACLE_HOME/bin:$PATH
        export ORACLE_SID={{ oracle_sid }}
        sqlplus -s / as sysdba << 'EOF'
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF LINESIZE 300
        ALTER SESSION SET NLS_DATE_FORMAT='DD/MM/YYYY HH24:MI:SS';
        SELECT
            CASE
                WHEN rp.con_id = 0 THEN 'CDB$ROOT'
                WHEN rp.con_id = 1 THEN 'CDB$ROOT'
                ELSE NVL(p.name, 'UNKNOWN')
            END                                           || '|' ||
            rp.name                                       || '|' ||
            rp.guarantee_flashback_database               || '|' ||
            TO_CHAR(rp.time, 'DD/MM/YYYY HH24:MI:SS')    || '|' ||
            TO_CHAR(ROUND((SYSDATE - rp.time), 2))        || '|' ||
            TO_CHAR(NVL(rp.storage_size, 0))              || '|' ||
            TO_CHAR(rp.scn)
        FROM v$restore_point rp
        LEFT JOIN v$pdbs p ON rp.con_id = p.con_id
        ORDER BY rp.con_id, rp.time DESC;
        EXIT;
        EOF
      register: rp_output
      changed_when: false

    - name: "5 | Parsear lineas validas"
      ansible.builtin.set_fact:
        rp_lines: >-
          {{ rp_output.stdout_lines
             | select('match', '^[^|]+\|[^|]+\|[^|]+\|[^|]+\|[^|]+\|[^|]+\|[^|]+$')
             | map('trim')
             | list }}

    # =========================================
    # ESCRIBIR RESULTADO EN LOG
    # =========================================
    - name: "6 | Escribir resultado CON restore points"
      ansible.builtin.blockinfile:
        path: "{{ log_file }}"
        marker: "# {mark} RESULTADO CONSULTA"
        block: |
          RESULTADO: ⚠️  SE ENCONTRARON {{ rp_lines | length }} RESTORE POINT(S) ACTIVOS

          DETALLE:
          {% for rp in rp_lines %}
          {% set c = rp.split('|') %}
            Contenedor : {{ c[0] | trim }}
            Nombre     : {{ c[1] | trim }}
            Guaranteed : {{ c[2] | trim }}
            Creado     : {{ c[3] | trim }}
            Antigüedad : {{ c[4] | trim }} días
            Storage    : {{ (c[5] | trim | int / 1073741824) | round(2) }} GB
            SCN        : {{ c[6] | trim }}
            --------------------------------------------------
          {% endfor %}
      when: rp_lines | length > 0

    - name: "6 | Escribir resultado SIN restore points"
      ansible.builtin.blockinfile:
        path: "{{ log_file }}"
        marker: "# {mark} RESULTADO CONSULTA"
        block: |
          RESULTADO: ✅ No se encontraron Restore Points activos.
      when: rp_lines | length == 0

    - name: "6 | Escribir errores en log si los hay"
      ansible.builtin.blockinfile:
        path: "{{ log_file }}"
        marker: "# {mark} ERRORES"
        block: |
          ⚠️  ERRORES DETECTADOS:
          {{ rp_output.stderr }}
      when:
        - rp_output.stderr is defined
        - rp_output.stderr != ''

    - name: "6 | Escribir pie del log"
      ansible.builtin.lineinfile:
        path: "{{ log_file }}"
        line: |
          ============================================================
          FIN DE CONSULTA - {{ ansible_date_time.iso8601 }}
          ============================================================
        insertafter: EOF

    # =========================================
    # RESUMEN CONSOLIDADO - SOLO CON RP
    # =========================================
    - name: "7 | Inicializar fichero resumen (solo primera vez)"
      ansible.builtin.copy:
        dest: "{{ reports_salida }}RESUMEN_CON_RP_{{ ansible_date_time.date }}.txt"
        content: |
          ============================================================
          RESUMEN - BASES DE DATOS CON RESTORE POINTS ACTIVOS
          Fecha: {{ ansible_date_time.date }}
          ============================================================
        force: false
        mode: '0644'
      run_once: true

    - name: "7 | Añadir al resumen solo si tiene restore points"
      ansible.builtin.blockinfile:
        path: "{{ reports_salida }}RESUMEN_CON_RP_{{ ansible_date_time.date }}.txt"
        marker: "# {mark} {{ inventory_hostname }}_{{ cdb }}"
        block: |

          ┌──────────────────────────────────────────────────────────
          │ Host : {{ inventory_hostname }}  |  CDB : {{ cdb }}
          ├──────────────────────────────────────────────────────────
          {% for rp in rp_lines %}
          {% set c = rp.split('|') %}
          │  Contenedor : {{ c[0] | trim }}
          │  Nombre     : {{ c[1] | trim }}
          │  Guaranteed : {{ c[2] | trim }}
          │  Creado     : {{ c[3] | trim }}
          │  Antigüedad : {{ c[4] | trim }} días
          │  Storage    : {{ (c[5] | trim | int / 1073741824) | round(2) }} GB
          │  SCN        : {{ c[6] | trim }}
          │
          {% endfor %}
          └──────────────────────────────────────────────────────────
        insertafter: EOF
      when: rp_lines | length > 0

  post_tasks:

    - name: "POST | Pie del resumen consolidado"
      ansible.builtin.lineinfile:
        path: "{{ reports_salida }}RESUMEN_CON_RP_{{ ansible_date_time.date }}.txt"
        line: |
          ============================================================
          FIN DEL RESUMEN - {{ ansible_date_time.iso8601 }}
          ============================================================
        insertafter: EOF
      run_once: true
```

---

## Ficheros generados en `/tmp/ansible/salida/`
```
# Log individual por cada host (todos)
restore_points_oradb01_2026-02-23.log
restore_points_oradb02_2026-02-23.log

# Resumen consolidado (solo los que tienen restore points)
RESUMEN_CON_RP_2026-02-23.txt


*************************************************************************************************************************************************************************
post_tasks:

    - name: "POST | Pie del resumen consolidado"
      ansible.builtin.lineinfile:
        path: "{{ resumen_file }}"
        line: |
          ============================================================
          FIN DEL RESUMEN - {{ ansible_date_time.iso8601 }}
          ============================================================
        insertafter: EOF
      run_once: true

    - name: "POST | Traer log individual solo si tiene restore points"
      ansible.builtin.fetch:
        src:  "{{ log_file }}"
        dest: "/ansible_restore_point/{{ inventory_hostname }}_{{ cdb }}_{{ ansible_date_time.date }}.log"
        flat: true
      when: rp_lines | length > 0

    - name: "POST | Traer resumen consolidado a maquina local"
      ansible.builtin.fetch:
        src:  "{{ resumen_file }}"
        dest: "/ansible_restore_point/RESUMEN_CON_RP_{{ ansible_date_time.date }}.txt"
        flat: true
      run_once: true
