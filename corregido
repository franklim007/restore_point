---
# ================================================================
# PLAY 1: Ejecutar consulta en servidores Oracle y traer resultado
# ================================================================
- name: Consultar Restore Points Oracle 19c Multitenant
  hosts: oracle_servers
  become: yes
  become_user: "{{ oracle_os_user }}"
  gather_facts: yes

  tasks:

    - name: Obtener instancias Oracle activas desde oratab
      shell: grep -v '^#' /etc/oratab | grep -v '^$' | awk -F: '$1 != "*" {print $1}'
      register: oracle_instances_raw
      changed_when: false

    - name: Registrar lista de instancias
      set_fact:
        oracle_instances: "{{ oracle_instances_raw.stdout_lines | select('ne', '') | list }}"

    - name: Consultar restore points por cada instancia
      shell: |
        export ORACLE_SID="{{ item }}"
        export ORACLE_HOME="{{ oracle_home }}"
        export PATH="{{ oracle_home }}/bin:$PATH"
        export LD_LIBRARY_PATH="{{ oracle_home }}/lib"

        sqlplus -s / as sysdba << 'ENDSQL'
        SET LINESIZE 300
        SET PAGESIZE 0
        SET FEEDBACK OFF
        SET HEADING OFF
        SET TRIMOUT ON
        SET TRIMSPOOL ON
        SET NEWPAGE NONE

        -- Restore points en CDB (CON_ID=0 o 1)
        SELECT
          'RESTORE_POINT|' ||
          '{{ inventory_hostname }}' || '|' ||
          d.NAME                     || '|' ||
          'CDB'                      || '|' ||
          rp.NAME                    || '|' ||
          TO_CHAR(rp.TIME, 'YYYY-MM-DD HH24:MI:SS')
        FROM V$RESTORE_POINT rp
        CROSS JOIN V$DATABASE d
        WHERE rp.CON_ID IN (0, 1);

        -- Restore points en PDBs (CON_ID > 1)
        SELECT
          'RESTORE_POINT|' ||
          '{{ inventory_hostname }}' || '|' ||
          d.NAME                     || '|' ||
          p.NAME                     || '|' ||
          rp.NAME                    || '|' ||
          TO_CHAR(rp.TIME, 'YYYY-MM-DD HH24:MI:SS')
        FROM V$RESTORE_POINT rp
        JOIN V$PDBS p        ON rp.CON_ID = p.CON_ID
        CROSS JOIN V$DATABASE d
        WHERE rp.CON_ID > 1;

        EXIT;
        ENDSQL
      loop: "{{ oracle_instances }}"
      register: sql_output
      changed_when: false
      failed_when: false

    - name: Crear directorio local en máquina de control
      delegate_to: localhost
      become: no
      file:
        path: "{{ local_output_dir }}"
        state: directory
        mode: '0755'

    - name: Generar fichero de resultado en el servidor remoto
      copy:
        dest: "/tmp/restore_points_{{ inventory_hostname }}.txt"
        content: |
          {% set ns = namespace(found=false) %}
          ============================================================
          RESTORE POINTS - {{ inventory_hostname }}
          Fecha consulta : {{ ansible_date_time.iso8601 }}
          ============================================================
          {% for result in sql_output.results %}
          {% for line in result.stdout_lines %}
          {% if line.startswith('RESTORE_POINT|') %}
          {% set ns.found = true %}
          {% set fields = line.split('|') %}
          Máquina  : {{ fields[1] }}
          BD (CDB) : {{ fields[2] }}
          PDB      : {{ fields[3] }}
          Nombre   : {{ fields[4] }}
          Fecha    : {{ fields[5] }}
          ------------------------------------------------------------
          {% endif %}
          {% endfor %}
          {% endfor %}
          {% if not ns.found %}
          No hay restore points activos en este servidor.
          {% endif %}

    - name: Traer fichero a la máquina de control
      fetch:
        src: "/tmp/restore_points_{{ inventory_hostname }}.txt"
        dest: "{{ local_output_dir }}/restore_points_{{ inventory_hostname }}.txt"
        flat: yes

# ================================================================
# PLAY 2: Generar resumen global en la máquina de control
# ================================================================
- name: Generar resumen global en máquina de control
  hosts: localhost
  gather_facts: yes

  vars:
    local_output_dir: /tmp/oracle_restore_points
    local_summary_file: /tmp/oracle_restore_points/resumen_global.txt

  tasks:

    - name: Buscar ficheros descargados
      find:
        paths: "{{ local_output_dir }}"
        patterns: "restore_points_*.txt"
      register: result_files

    - name: Leer contenido de cada fichero
      slurp:
        src: "{{ item.path }}"
      loop: "{{ result_files.files }}"
      register: file_contents

    - name: Generar resumen global
      copy:
        dest: "{{ local_summary_file }}"
        content: |
          {% set ns = namespace(total_bd=0, bloques=[]) %}
          {% for file in file_contents.results %}
          {% set content = file.content | b64decode %}
          {% if 'Nombre   :' in content %}
          {% set ns.total_bd = ns.total_bd + 1 %}
          {% set ns.bloques = ns.bloques + [content] %}
          {% endif %}
          {% endfor %}
          ============================================================
          RESUMEN GLOBAL DE RESTORE POINTS ACTIVOS
          Generado : {{ ansible_date_time.iso8601 }}
          ============================================================

          {% if ns.total_bd == 0 %}
          >>> No existen restore points activos en ninguna base de datos <
          {% else %}
          Hay {{ ns.total_bd }} servidor(es) con restore points activos:
          ============================================================
          {% for bloque in ns.bloques %}
          {{ bloque }}
          {% endfor %}
          {% endif %}

          ============================================================
          FIN DEL RESUMEN
          ============================================================

    - name: Mostrar resumen por pantalla
      debug:
        msg: "{{ lookup('file', local_summary_file).splitlines() }}"

    - name: Indicar ubicación de ficheros
      debug:
        msg:
          - "Ficheros por servidor : {{ local_output_dir }}/restore_points_<servidor>.txt"
          - "Resumen global        : {{ local_summary_file }}"
```

