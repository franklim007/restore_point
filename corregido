---
# ================================================================
# PLAY 1: Consultar restore points en CDB y PDBs
# ================================================================
- name: Consultar Restore Points Oracle 19c Multitenant
  hosts: oracle_servers
  become: yes
  become_user: "{{ oracle_os_user }}"
  gather_facts: yes
  vars_files:
    - vault/secrets.yml

  tasks:

    # -------------------------------------------------------
    # Cargar ORACLE_HOME desde el cdb.env de la CDB
    # -------------------------------------------------------
    - name: Cargar ORACLE_HOME desde cdb.env
      shell: |
        source /home/oracle/{{ cdb }}.env
        echo $ORACLE_HOME
      register: home_cdb
      changed_when: false
      failed_when: home_cdb.stdout == ''

    - name: Debug ORACLE_HOME cargado
      debug:
        msg: "ORACLE_HOME para {{ cdb }} en {{ inventory_hostname }}: {{ home_cdb.stdout }}"

    # -------------------------------------------------------
    # Verificar si la BD es CDB (Multitenant)
    # -------------------------------------------------------
    - name: Comprobar si la instancia es CDB
      shell: |
        export ORACLE_HOME={{ home_cdb.stdout }}
        export PATH=$ORACLE_HOME/bin:$PATH
        export ORACLE_SID={{ oracle_sid }}
        sqlplus -s / as sysdba << EOF
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF
        SELECT cdb FROM v\$database;
        EXIT;
        EOF
      register: is_cdb
      changed_when: false

    - name: Establecer si es CDB
      set_fact:
        is_multitenant: "{{ 'YES' in is_cdb.stdout }}"

    - name: Mostrar tipo de arquitectura
      debug:
        msg: |
          Servidor     : {{ inventory_hostname }}
          SID          : {{ oracle_sid }}
          CDB          : {{ cdb }}
          Arquitectura : {{ 'Multitenant (CDB/PDB)' if is_multitenant else 'Non-CDB (Single Instance)' }}

    # -------------------------------------------------------
    # Obtener y parsear lista de PDBs
    # -------------------------------------------------------
    - name: Obtener lista de PDBs
      shell: |
        export ORACLE_HOME={{ home_cdb.stdout }}
        export PATH=$ORACLE_HOME/bin:$PATH
        export ORACLE_SID={{ oracle_sid }}
        sqlplus -s / as sysdba << EOF
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF
        SELECT name || '|' || con_id || '|' || open_mode FROM v\$pdbs ORDER BY con_id;
        EXIT;
        EOF
      register: pdbs_list
      when: is_multitenant
      changed_when: false

    - name: Parsear información de PDBs
      set_fact:
        pdbs: "{{ pdbs | default([]) +
                  [ {
                    'name':      item.split('|')[0] | trim,
                    'con_id':    item.split('|')[1] | trim,
                    'open_mode': item.split('|')[2] | trim
                  } ]
               }}"
      with_items: "{{ pdbs_list.stdout_lines }}"
      when:
        - is_multitenant
        - pdbs_list is defined
        - item | length > 0

    - name: Mostrar PDBs encontradas
      debug:
        msg: |
          PDBs encontradas en {{ inventory_hostname }}:
          {% for pdb in pdbs | default([]) %}
          - {{ pdb.name }} (CON_ID: {{ pdb.con_id }}) - Estado: {{ pdb.open_mode }}
          {% endfor %}
      when: is_multitenant

    # -------------------------------------------------------
    # Consultar restore points en la CDB (conexión local)
    # -------------------------------------------------------
    - name: Consultar restore points en CDB
      shell: |
        export ORACLE_HOME={{ home_cdb.stdout }}
        export PATH=$ORACLE_HOME/bin:$PATH
        export ORACLE_SID={{ oracle_sid }}
        sqlplus -s / as sysdba << EOF
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF
        SELECT
          'RP|' ||
          '{{ inventory_hostname }}'                      || '|' ||
          d.NAME                                          || '|' ||
          'CDB'                                           || '|' ||
          rp.NAME                                         || '|' ||
          TO_CHAR(rp.TIME, 'YYYY-MM-DD HH24:MI:SS')
        FROM V\$RESTORE_POINT rp
        CROSS JOIN V\$DATABASE d
        WHERE rp.CON_ID IN (0, 1);
        EXIT;
        EOF
      register: cdb_rp
      changed_when: false
      failed_when: false

    # -------------------------------------------------------
    # Consultar restore points en cada PDB (via SCAN)
    # -------------------------------------------------------
    - name: Consultar restore points en cada PDB
      shell: |
        export ORACLE_HOME={{ home_cdb.stdout }}
        export PATH=$ORACLE_HOME/bin:$PATH
        sqlplus -s 'sys/{{ sys_p }}@{{ scan }}:{{ port }}/{{ item.name }}.{{ pdb_domain }} as sysdba' << EOF
        SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF
        SELECT
          'RP|' ||
          '{{ inventory_hostname }}'                      || '|' ||
          (SELECT NAME FROM V\$DATABASE)                  || '|' ||
          SYS_CONTEXT('USERENV', 'CON_NAME')              || '|' ||
          rp.NAME                                         || '|' ||
          TO_CHAR(rp.TIME, 'YYYY-MM-DD HH24:MI:SS')
        FROM V\$RESTORE_POINT rp;
        EXIT;
        EOF
      loop: "{{ pdbs | default([]) }}"
      loop_control:
        label: "{{ item.name }}"
      register: pdb_rp
      when:
        - is_multitenant
        - item.name != 'PDB$SEED'
      changed_when: false
      failed_when: false
      no_log: true

    # -------------------------------------------------------
    # Consolidar todas las líneas RP| encontradas
    # -------------------------------------------------------
    - name: Consolidar restore points CDB y PDBs
      set_fact:
        all_rp_lines: >-
          {{
            (cdb_rp.stdout_lines | select('match', '^RP\|') | list)
            +
            (pdb_rp.results | default([])
              | selectattr('stdout_lines', 'defined')
              | map(attribute='stdout_lines') | flatten
              | select('match', '^RP\|') | list)
          }}

    - name: Mostrar restore points encontrados (debug)
      debug:
        msg: |
          Restore points en {{ inventory_hostname }} / {{ cdb }}:
          {% if all_rp_lines | length == 0 %}
          No hay restore points activos.
          {% else %}
          {% for line in all_rp_lines %}
          {% set f = line.split('|') %}
          - Máquina: {{ f[1] }} | BD: {{ f[2] }} | PDB: {{ f[3] }} | Nombre: {{ f[4] }} | Fecha: {{ f[5] }}
          {% endfor %}
          {% endif %}

    # -------------------------------------------------------
    # Generar fichero TXT en el servidor remoto
    # -------------------------------------------------------
    - name: Generar fichero TXT en servidor remoto
      copy:
        dest: "/tmp/restore_points_{{ inventory_hostname }}_{{ cdb }}.txt"
        content: |
          ============================================================
          RESTORE POINTS  |  {{ inventory_hostname }}  |  CDB: {{ cdb }}
          SID             : {{ oracle_sid }}
          SCAN            : {{ scan }}
          Arquitectura    : {{ 'Multitenant (CDB/PDB)' if is_multitenant else 'Non-CDB' }}
          Fecha consulta  : {{ ansible_date_time.iso8601 }}
          ============================================================
          {% if all_rp_lines | length == 0 %}

          No hay restore points activos en este servidor/CDB.

          {% else %}
          {% for line in all_rp_lines %}
          {% set f = line.split('|') %}

          Máquina : {{ f[1] }}
          BD(CDB) : {{ f[2] }}
          PDB     : {{ f[3] }}
          Nombre  : {{ f[4] }}
          Fecha   : {{ f[5] }}
          ------------------------------------------------------------
          {% endfor %}
          {% endif %}
          ============================================================

    # -------------------------------------------------------
    # Traer fichero a la máquina de control
    # -------------------------------------------------------
    - name: Crear directorio local en máquina de control
      delegate_to: localhost
      become: no
      file:
        path: "{{ local_output_dir }}"
        state: directory
        mode: '0755'

    - name: Fetch fichero al equipo de control
      fetch:
        src: "/tmp/restore_points_{{ inventory_hostname }}_{{ cdb }}.txt"
        dest: "{{ local_output_dir }}/restore_points_{{ inventory_hostname }}_{{ cdb }}.txt"
        flat: yes


# ================================================================
# PLAY 2: Resumen global en la máquina de control
# ================================================================
- name: Generar resumen global en máquina de control
  hosts: localhost
  gather_facts: yes

  vars:
    local_output_dir: /tmp/oracle_restore_points
    local_summary_file: /tmp/oracle_restore_points/resumen_global.txt

  tasks:

    - name: Buscar ficheros descargados
      find:
        paths: "{{ local_output_dir }}"
        patterns: "restore_points_*.txt"
      register: result_files

    - name: Leer contenido de cada fichero
      slurp:
        src: "{{ item.path }}"
      loop: "{{ result_files.files }}"
      register: file_contents

    - name: Construir resumen global
      copy:
        dest: "{{ local_summary_file }}"
        content: |
          {% set ns = namespace(total=0, bloques=[]) %}
          {% for file in file_contents.results %}
          {% set content = file.content | b64decode %}
          {% if 'Nombre  :' in content %}
          {% set ns.total = ns.total + 1 %}
          {% set ns.bloques = ns.bloques + [content] %}
          {% endif %}
          {% endfor %}
          ============================================================
          RESUMEN GLOBAL DE RESTORE POINTS ACTIVOS
          Generado : {{ ansible_date_time.iso8601 }}
          ============================================================

          {% if ns.total == 0 %}
          >>> No existen restore points activos en ninguna base de datos <

          {% else %}
          >>> Hay {{ ns.total }} base(s) de datos con restore points activos <
          ============================================================
          {% for bloque in ns.bloques %}
          {{ bloque }}
          {% endfor %}
          {% endif %}

          ============================================================
          FIN DEL RESUMEN
          ============================================================

    - name: Mostrar resumen por pantalla
      debug:
        msg: "{{ lookup('file', local_summary_file).splitlines() }}"

    - name: Indicar ubicación de ficheros
      debug:
        msg:
          - "Ficheros individuales : {{ local_output_dir }}/restore_points_<host>_<cdb>.txt"
          - "Resumen global        : {{ local_summary_file }}"
